{
  "name": "dealflow360-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build": "npm --prefix backend run build && npm --prefix frontend run build",
    "test": "npm --prefix backend test",
    "seed": "npm --prefix backend run seed",
    "bootstrap:appwrite": "npm --prefix backend run bootstrap:appwrite"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
